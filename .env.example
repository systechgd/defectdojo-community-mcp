# Copy to .env and fill in. .env is git-ignored -- never commit a real token.

# Base URL of your DefectDojo instance (no trailing /api/v2).
DEFECTDOJO_URL=https://defectdojo.example.com

# API v2 token, from DefectDojo -> your user -> API v2 Key.
# Use a dedicated READ-ONLY user: this server never needs write access.
DEFECTDOJO_API_KEY=replace-me

# Optional. Set to false only for a trusted instance with a self-signed cert.
# DEFECTDOJO_VERIFY_TLS=true

# Optional. Per-request HTTP timeout in seconds (default 30).
# DEFECTDOJO_TIMEOUT_SECONDS=30
